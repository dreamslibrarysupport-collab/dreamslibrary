# Copy to server/.env. Never prefix server secrets with VITE_.
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@YOUR-SUPABASE-POOLER:6543/postgres
# Require verified TLS for hosted Postgres. Set false ONLY for local Postgres.
DATABASE_SSL=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=YOUR_SERVER_ONLY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_SERVER_ONLY_WEBHOOK_SECRET
EMAIL_PROVIDER=log
EMAIL_FROM=Dream's Library <books@example.com>
RESEND_API_KEY=
MAX_DOWNLOADS_PER_BOOK=0
SIGNED_URL_TTL=300
TRUST_PROXY=0
# Explicit read-only demo catalog; must be false in production.
DEMO_MODE=true
# Frontend: copy these to client/.env (public values only).
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173
# Supabase Auth manages JWTs. No custom JWT_SECRET is needed.
# Razorpay public key is returned by the create-order endpoint.
